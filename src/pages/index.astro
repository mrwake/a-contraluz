---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const interviews = (await getCollection('interviews', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = interviews[0];
const moreInterviews = interviews.slice(1);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Conversaciones para mirar despacio"
  description="Entrevistas, preguntas y retratos en blanco y negro."
>
  <section class="intro">
    <p class="eyebrow">UN ARCHIVO DE VOCES Y MIRADAS</p>
    <h1>Historias que<br />merecen <em>tiempo.</em></h1>
    <p class="intro-copy">
      Cocinas, talleres y vidas contadas sin prisa. Un retrato, unas preguntas
      y espacio para escuchar.
    </p>
    <p class="sample-note">Las entrevistas y los retratos ficticios se identifican en cada historia.</p>
  </section>

  {featured && (
    <section class="featured" aria-labelledby="featured-title">
      <a class="featured-image-link" href={`${base}entrevistas/${featured.id}/`}>
        <img
          class:list={['featured-image', featured.data.coverPortrait && 'featured-image--portrait']}
          src={`${base}${featured.data.cover.replace(/^\//, '')}`}
          alt={featured.data.coverAlt}
        />
      </a>
      <div class="featured-copy">
        <p class="eyebrow">ENTREVISTA DESTACADA · {featured.data.format.toUpperCase()} · {featured.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long' })}</p>
        <h2 id="featured-title">
          <a href={`${base}entrevistas/${featured.id}/`}>{featured.data.title}</a>
        </h2>
        <p class="person">{featured.data.person}</p>
        <p class="description">{featured.data.description}</p>
        <a class="text-link" href={`${base}entrevistas/${featured.id}/`}>Leer la conversación <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  )}

  {moreInterviews.length > 0 && (
    <section class="archive" aria-labelledby="archive-title">
      <div class="section-heading">
        <h2 id="archive-title">Otras conversaciones</h2>
        <span>{String(interviews.length).padStart(2, '0')} historias</span>
      </div>
      <div class="archive-grid">
        {moreInterviews.map((interview) => (
          <article class="archive-card">
            <a href={`${base}entrevistas/${interview.id}/`}>
              <img
                class:list={[interview.data.coverPortrait && 'archive-image--portrait']}
                src={`${base}${interview.data.cover.replace(/^\//, '')}`}
                alt={interview.data.coverAlt}
                loading="lazy"
              />
              <p class="eyebrow">{interview.data.format.toUpperCase()} · {interview.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long' })}</p>
              <h3>{interview.data.title}</h3>
              <p class="person">{interview.data.person}</p>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  {!featured && (
    <p class="empty-state">Todavía no hay entrevistas publicadas. La primera empieza con una buena pregunta.</p>
  )}
</BaseLayout>

<style>
  .intro {
    max-width: 760px;
    padding: clamp(4rem, 10vw, 9rem) 0 clamp(3rem, 7vw, 6rem);
  }

  .eyebrow {
    color: var(--muted);
    font-family: Arial, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.93;
    margin: 1.5rem 0;
  }

  h1 em {
    font-weight: 400;
  }

  .intro-copy {
    color: var(--muted);
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.65;
    max-width: 34rem;
  }

  .sample-note {
    color: var(--accent);
    font-family: Arial, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    margin-top: 1.6rem;
  }

  .featured {
    align-items: center;
    border-top: 1px solid var(--line);
    display: grid;
    gap: clamp(2rem, 7vw, 7rem);
    grid-template-columns: 1.15fr 0.85fr;
    padding: 2rem 0 4rem;
  }

  .featured-image-link {
    display: block;
    overflow: hidden;
  }

  .featured-image {
    aspect-ratio: 1.25;
    display: block;
    filter: grayscale(1);
    object-fit: cover;
    transition: transform 400ms ease;
    width: 100%;
  }

  .featured-image--portrait {
    aspect-ratio: auto;
    height: auto;
    margin: 0 auto;
    max-height: 560px;
    max-width: 100%;
    object-fit: contain;
    width: auto;
  }

  .featured-image-link:hover .featured-image {
    transform: scale(1.02);
  }

  .featured-copy {
    max-width: 29rem;
    padding: 2rem 0;
  }

  .featured-copy h2 {
    font-size: clamp(2.3rem, 4vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.05;
    margin: 1.4rem 0 0.75rem;
  }

  .featured-copy h2 a,
  .archive-card a {
    text-decoration: none;
  }

  .featured-copy h2 a:hover,
  .archive-card a:hover h3 {
    color: var(--accent);
  }

  .person,
  .description {
    color: var(--muted);
    line-height: 1.65;
  }

  .description {
    margin: 1.5rem 0 2rem;
  }

  .text-link {
    border-bottom: 1px solid currentColor;
    font-family: Arial, sans-serif;
    font-size: 0.78rem;
    padding-bottom: 0.35rem;
    text-decoration: none;
  }

  .archive {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }

  .section-heading {
    align-items: baseline;
    display: flex;
    justify-content: space-between;
  }

  .section-heading h2 {
    font-size: 1.6rem;
    font-weight: 400;
  }

  .section-heading span {
    color: var(--muted);
    font-family: Arial, sans-serif;
    font-size: 0.72rem;
  }

  .archive-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 1rem 0;
  }

  .archive-card img {
    aspect-ratio: 1.35;
    filter: grayscale(1);
    object-fit: cover;
    width: 100%;
  }

  .archive-card img.archive-image--portrait {
    aspect-ratio: auto;
    height: auto;
    object-fit: contain;
  }

  .archive-card h3 {
    font-size: 1.35rem;
    font-weight: 400;
    margin: 0.65rem 0 0.2rem;
  }

  .archive-card .person {
    font-size: 0.9rem;
    margin: 0;
  }

  .empty-state {
    border-top: 1px solid var(--line);
    color: var(--muted);
    padding: 2rem 0;
  }

  @media (max-width: 760px) {
    .featured {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .featured-copy {
      padding: 1rem 0;
    }

    .archive-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .archive-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
