---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const interviews = await getCollection('interviews', ({ data }) => !data.draft);
  return interviews.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="interview">
    <a class="back-link" href={base}>← Volver al archivo</a>
    <header class="article-header">
      <p class="eyebrow">ENTREVISTA · {entry.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
      <h1>{entry.data.title}</h1>
      <p class="person">{entry.data.person}</p>
      <p class="description">{entry.data.description}</p>
    </header>
    <figure class:list={['portrait', entry.data.coverPortrait && 'portrait--vertical']}>
      <img src={`${base}${entry.data.cover.replace(/^\//, '')}`} alt={entry.data.coverAlt} />
    </figure>
    <div class="prose">
      <Content />
    </div>
    <a class="back-link bottom-link" href={base}>← Más conversaciones</a>
  </article>
</BaseLayout>

<style>
  .interview {
    margin: 0 auto;
    max-width: 920px;
  }

  .back-link {
    color: var(--muted);
    display: inline-block;
    font-family: Arial, sans-serif;
    font-size: 0.75rem;
    margin-top: 2rem;
    text-decoration: none;
  }

  .article-header {
    margin: 0 auto;
    max-width: 700px;
    padding: clamp(3rem, 8vw, 7rem) 0 2rem;
    text-align: center;
  }

  .eyebrow {
    color: var(--muted);
    font-family: Arial, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.8rem, 7vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.98;
    margin: 1.3rem 0;
  }

  .person,
  .description {
    color: var(--muted);
    line-height: 1.7;
  }

  .portrait {
    margin: 1rem 0 4rem;
  }

  .portrait img {
    aspect-ratio: 1.8;
    filter: grayscale(1);
    object-fit: cover;
    width: 100%;
  }

  .portrait--vertical img {
    aspect-ratio: auto;
    display: block;
    height: auto;
    margin-inline: auto;
    max-height: min(100vh, 780px);
    max-width: 100%;
    object-fit: contain;
    width: auto;
  }

  .prose {
    font-size: 1.12rem;
    line-height: 1.85;
    margin: 0 auto;
    max-width: 650px;
  }

  .prose :global(h2) {
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1.35;
    margin: 3rem 0 0.8rem;
  }

  .prose :global(p) {
    color: #d0cdc6;
    margin: 0 0 1.25rem;
  }

  .prose :global(img) {
    display: block;
    filter: grayscale(1);
    height: auto;
    margin: 2.5rem auto;
    max-width: 100%;
    width: 100%;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    color: var(--accent);
    font-size: 0.9rem;
    margin: 0 0 2.5rem;
    padding-left: 1rem;
  }

  .prose :global(blockquote p) {
    color: inherit;
    margin: 0;
  }

  .bottom-link {
    border-top: 1px solid var(--line);
    margin: 4rem 0 2rem;
    padding-top: 1.5rem;
    width: 100%;
  }
</style>
